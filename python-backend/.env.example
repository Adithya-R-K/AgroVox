# AgroVox environment configuration
#
# AgroVox runs FULLY OFFLINE with no environment variables required at all -
# every value below is optional and only relevant if you want to enable the
# heavier neural backends documented in README.md -> "Fallback Strategy".
#
# To use: copy this file to `.env` and uncomment/edit the values you need,
# then either `export $(cat .env | xargs)` before running the app, or load
# it with a tool such as `python-dotenv` / your hosting platform's env var
# / secrets manager. NEVER commit a real `.env` file with live tokens.

# Enable the optional neural machine-translation backend (facebook/nllb-200
# by default - see src/translation/translator.py). Requires `transformers`
# and `torch` to be installed (uncomment in requirements.txt) AND internet
# access to download the model checkpoint on first use.
# AGROVOX_ENABLE_NEURAL_MT=false

# Enable the optional sentence-embedding QA retriever (requires
# `sentence-transformers` + internet access to download the checkpoint).
# AGROVOX_ENABLE_NEURAL_QA=false

# Enable Whisper-based speech-to-text (requires `openai-whisper` installed;
# the model itself is downloaded on first use).
# AGROVOX_ENABLE_WHISPER_ASR=false

# Enable gTTS-based text-to-speech (requires `gTTS` installed and outbound
# internet access to Google's TTS endpoint).
# AGROVOX_ENABLE_TTS=false

# Optional: Hugging Face access token, only needed if you select a gated
# model for the optional neural MT/QA backends above.
# HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
